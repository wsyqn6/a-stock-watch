{"name":"a-stock-watch","displayName":"A股速览","description":"A-share (Chinese stock) watchlist with real-time quotes in the VS Code sidebar","version":"0.1.5","publisher":"wsyqn6","private":true,"repository":{"type":"git","url":"https://github.com/wsyqn6/a-stock-watch.git"},"homepage":"https://github.com/wsyqn6/a-stock-watch#readme","bugs":{"url":"https://github.com/wsyqn6/a-stock-watch/issues"},"engines":{"vscode":"^1.90.0"},"categories":["Other"],"main":"./out/extension.js","icon":"media/icon-128.png","changelog":"CHANGELOG.md","contributes":{"views":{"aStockWatchContainer":[{"id":"aStockWatch","name":"A股速览","type":"webview"}]},"viewsContainers":{"activitybar":[{"id":"aStockWatchContainer","title":"A股速览","icon":"media/activitybar.svg"}]},"commands":[{"command":"a-stock-watch.add","title":"添加自选股","icon":"$(add)"},{"command":"a-stock-watch.remove","title":"删除自选股","icon":"$(trash)"},{"command":"a-stock-watch.sort","title":"排序自选股","icon":"$(arrow-swap)"},{"command":"a-stock-watch.edit","title":"编辑自选股","icon":"$(pencil)"},{"command":"a-stock-watch.refresh","title":"刷新行情","icon":"$(refresh)"},{"command":"a-stock-watch.show","title":"显示自选股"}],"menus":{"view/title":[{"command":"a-stock-watch.add","when":"view == aStockWatch","group":"navigation@1"},{"command":"a-stock-watch.edit","when":"view == aStockWatch && !aStockWatch.editing","group":"navigation@2"},{"command":"a-stock-watch.edit","when":"view == aStockWatch && aStockWatch.editing","group":"navigation@2","icon":"$(check)","title":"完成编辑"},{"command":"a-stock-watch.sort","when":"view == aStockWatch","group":"navigation@3"},{"command":"a-stock-watch.refresh","when":"view == aStockWatch","group":"navigation@4"}]},"configuration":{"title":"A股速览","properties":{"aStockWatch.refreshIntervalSec":{"type":"number","default":3,"minimum":1,"maximum":120,"description":"行情刷新间隔（秒）"},"aStockWatch.watchlist":{"type":"array","items":{"type":"string"},"default":[],"scope":"window","description":"自选股列表，数组顺序即显示顺序（可在设置中直接编辑）"},"aStockWatch.pinned":{"type":"array","items":{"type":"string"},"default":[],"scope":"window","description":"置顶自选股，始终显示在列表最前（须为自选股成员，可在设置中直接编辑）"},"aStockWatch.statusBar":{"type":"array","items":{"type":"string"},"default":[],"scope":"window","description":"状态栏显示的股票代码（须为自选股成员，最多3只，数组顺序即状态栏顺序，可在设置中直接编辑）"}}}},"scripts":{"compile":"tsc -p ./","test":"bun test","package":"bunx @vscode/vsce package --no-dependencies","publish":"bunx @vscode/vsce publish --no-dependencies"},"devDependencies":{"@types/node":"^26.1.2","@types/vscode":"^1.90.0","typescript":"^7.0.2"}}